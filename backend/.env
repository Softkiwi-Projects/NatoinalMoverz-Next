# ==============================================================================
# Contact Form API Service - Environment Configuration
# ==============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated, or * for all in dev)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://nationalmovers.co.nz

# Rate Limiting (5 requests per 15 minutes per IP)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@gmail.com
SMTP_PASS=add_16_words_pwd


# Email Routing
MAIL_FROM="National Movers Contact" <user@gmail.com>
MAIL_TO=owner@gmail.com
MAIL_SUBJECT_PREFIX=[Website Contact]
