# ==============================================================================
# Contact Form API Service - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated, or * for all in dev)
# Example: http://localhost:3000,https://nationalmovers.co.nz
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://nationalmovers.co.nz

# Rate Limiting
# Maximum number of requests permitted per IP address within the window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5

# Google SMTP / Gmail Configuration
# For Gmail, generate a 16-character "App Password":
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Enable "2-Step Verification" (if not already enabled)
# 3. Search for or navigate to "App Passwords" (https://myaccount.google.com/apppasswords)
# 4. Create a new App Password (name it e.g. "Website Contact Form")
# 5. Paste the 16-letter generated password into SMTP_PASS below (no spaces required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password

# Email Routing
# MAIL_FROM: Sender header in outbound notification emails
MAIL_FROM="National Movers Contact Form" <your-email@gmail.com>

# MAIL_TO: Destination address where incoming form submissions will be emailed
MAIL_TO=hardikgujral1@gmail.com

# Optional subject prefix
MAIL_SUBJECT_PREFIX=[Website Contact]
